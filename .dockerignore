# Keep the build context small and avoid ever baking dev-machine state
# (secrets, local databases, caches) into an image layer.

.git/
.github/

# Desktop shell (ADR-017) -- a separate deployment shape this image
# never needs; its frontend build tooling would otherwise dominate the
# build context.
apps/desktop/frontend/node_modules/
apps/desktop/frontend/dist/

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.pytest-tmp/
.cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local runtime state / secrets
.env
.env.*
!.env.example
.orchai/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
.tmp/
tmp/

# Editors and OS
.idea/
.vscode/
*.swp
Thumbs.db
.DS_Store

# Docs and tests are not needed inside the image
docs/
tests/
