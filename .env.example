# PostgreSQL is the explicit production default (also used when this
# variable is unset entirely). Point it at your own server; secrets should
# come from environment variables or a secret manager, not committed
# project configuration.
ORCHAI_DATABASE_URL=postgresql://orchai:change-me@localhost:5432/orchai

# SQLite is a secondary option kept only to make local development and
# automated tests fast and dependency-free. Use the full URL, or the
# shorthand alias below, to opt into it explicitly.
# ORCHAI_DATABASE_URL=sqlite:///.orchai/orchai.db
# ORCHAI_DATABASE_URL=sqlite
